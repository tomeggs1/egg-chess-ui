# Force lockfile writes for this project, overriding a global package-lock=false
# in ~/.npmrc. Without this, `npm install` updates package.json but not
# package-lock.json, and GCP's `npm ci` build fails on the mismatch.
package-lock=true

# Pin the PUBLIC npm registry for this project, overriding a global ~/.npmrc that
# defaults to a private Azure Artifacts feed. Every dependency here is public, so
# the CI `npm ci` needs no auth token. Without this, a local `npm install` writes
# Azure tarball URLs into the lockfile and the cloud build fails with E401.
registry=https://registry.npmjs.org/
